{
  "name": "noilucvang",
  "version": "1.0.0",
  "private": true,
  "description": "NoiLucVang video production (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render Main out/main.mp4",
    "render:hq": "remotion render Main out/main-hq.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-bitrate=320k --x264-preset=slow",
    "render:prores": "remotion render Main out/main.mov --codec=prores --prores-profile=hq",
    "render:vertical": "remotion render Vertical out/vertical.mp4 --crf=16",
    "still": "remotion still Main out/still.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/media": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "@remotion/transitions": "^4.0.534",
    "@remotion/zod-types": "^4.0.534",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
